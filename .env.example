# Written by `npm run demo:prepare -- --neon --project-id <id>` (or --local). Never commit the real .env.
NEON_PROJECT_ID=
# The agent's read-only role on each demo branch (pooled).
AGENT_DATABASE_URL_DEMO_V1=
AGENT_DATABASE_URL_DEMO_V2=
# The evaluator's credential on the same branches (owner role; never given to the model).
EVAL_DATABASE_URL_DEMO_V1=
EVAL_DATABASE_URL_DEMO_V2=
# Direct (unpooled) owner connection for `npm run demo:migrate`.
OPERATOR_DATABASE_URL_DEMO_V2=
# Runs, events, learning deliveries and evaluations. On the deployed Function, the branch's DATABASE_URL is used.
CONTROL_DATABASE_URL=

# Mubit. Locally, MUBIT_API_KEY may stay unset: the CLI reads the keychain item mubit-neon-demo-key (macOS).
MUBIT_API_KEY=
MUBIT_CONNECT_URL=https://api.mubit.ai/openai/v1
BASE_MODEL=gemini-3-8-flash
# json_schema | json_object | none
RESPONSE_FORMAT=json_schema
# Neon AI Gateway's upstream models refuse OpenAI's `metadata` field, so the session comes from the conversation start.
MUBIT_SESSION_METADATA=off
# mubit (Mubit runtime calibration) | off (no runtime calibration in any mode)
CALIBRATION_BACKEND=mubit
CALIBRATION_NAMESPACE=demo

# The private demo's bearer token (generated by prepare).
DEMO_ACCESS_TOKEN=
